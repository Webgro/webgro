# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must never be committed.
#
# For Vercel deploys: add the same keys in Project Settings → Environment
# Variables. Mark them "Production" (or both Production + Preview if you
# want preview deployments to be fully functional).

# --- Resend (transactional email) -------------------------------------------
# Sign up: https://resend.com (free up to 3,000 emails/month, 100/day).
# Verify the webgro.co.uk domain in Resend so `from:` addresses like
# hello@webgro.co.uk don't land in spam. Then create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions get emailed (your Google Workspace inbox).
CONTACT_TO_EMAIL=hello@webgro.co.uk

# The verified "from" address Resend will send on behalf of. Must match
# the subdomain you verified in Resend (send.webgro.co.uk). Keeps
# transactional email isolated from your Google Workspace reputation.
# The display name ("Webgro Contact") is what recipients see; the
# address itself just needs to live on send.webgro.co.uk.
CONTACT_FROM_EMAIL=hello@send.webgro.co.uk

# --- Cloudflare Turnstile (bot protection) ----------------------------------
# Sign up: https://dash.cloudflare.com/?to=/:account/turnstile
# Create a widget for webgro.co.uk, get the Site Key (public) + Secret Key.
# Use the "Managed" challenge so it's invisible for legit users.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxx_secret

# --- Vapi web receptionist ---------------------------------------------------
# Powers the "Talk to our AI receptionist" orb in the contact sections.
# Both values are safe to expose in the browser (that's what the public key
# is for). Find them in the Vapi dashboard: Account → Public key, and the
# receptionist assistant's id. The orb renders nothing until both are set.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=


# --- Anthropic (guided enquiry on the contact page) --------------------------
# Server-only key for the AI follow-up questions and the internal brief in the
# enquiry email (src/lib/enquiry/ai.ts, model claude-opus-5). Never prefix it
# with NEXT_PUBLIC_. Leave it empty and the enquiry still works: it asks a
# fixed set of follow-up questions per service and writes a plain brief.
# Create a key at https://console.anthropic.com (Settings, API keys).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Signs the AI questions so the server can trust them when the
# browser sends them back. If empty, a key is derived from ANTHROPIC_API_KEY.
# Any long random string works, for example the output of: openssl rand -hex 32
ENQUIRY_SIGNING_SECRET=

# Newsletter signup in the footer (src/app/actions/newsletter.ts). A Klaviyo
# private API key with Subscriptions and Lists write access, and the ID of the
# list new subscribers are added to. With either missing, the form tells people
# signups are not open yet and nothing is sent.
KLAVIYO_PRIVATE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KLAVIYO_NEWSLETTER_LIST_ID=XXXXXX
